+static bool tensor_allows_pad_quant(const tensor_metadata & tm) {
+    const std::string & name = tm.name;
+
+    // V1 is matrix multiplication only. In particular, never widen embedding or lookup tables.
+    if (tm.category == tensor_category::TOKEN_EMBD ||
+        name.find("token_embd")           != std::string::npos ||
+        name.find("embed_tokens")         != std::string::npos ||
+        name.find("compressor_ape")       != std::string::npos ||
+        name.find("ffn_gate_tid2eid")     != std::string::npos ||
+        name.find("attn_rel_b")           != std::string::npos ||
+        name.find("markov_w1")            != std::string::npos ||
+        name.find("selector_predecessor") != std::string::npos ||
+        name.find("selector_successor")   != std::string::npos ||
+        name.find("d2t")                  != std::string::npos ||
+        name.find("conv")                 != std::string::npos) {
+        return false;
+    }
+
+    if (tm.category != tensor_category::OTHER) {
+        return true;
+    }
+
+    // Additional projection families used by hybrid/MoE architectures, including Qwen Flash-Next.
+    const bool projection_name =
+        name.find("attn_")           != std::string::npos ||
+        name.find("ffn_")            != std::string::npos ||
+        name.find("hc_")             != std::string::npos ||
+        name.find("ssm_")            != std::string::npos ||
+        name.find("ple_key")          != std::string::npos ||
+        name.find("ple_value")        != std::string::npos ||
+        name.find("nextn.eh_proj")    != std::string::npos ||
+        name.find("shared_head_head") != std::string::npos ||
+        name.find("model_proj")       != std::string::npos ||
+        name.find("dense_")           != std::string::npos ||
+        name == "output.weight";
+
+    const bool elementwise_name =
+        name.find("norm")  != std::string::npos ||
+        name.find("base")  != std::string::npos ||
+        name.find("scale") != std::string::npos ||
+        name.find("sinks") != std::string::npos ||
+        name.find("probs") != std::string::npos;
+
+    return projection_name && !elementwise_name;
+}
