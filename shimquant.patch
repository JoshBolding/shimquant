+ggml_tensor * llm_graph_context::build_pad_quant_input(
+          ggml_tensor * w,
+          ggml_tensor * cur) const {
+    if (pad_orig_ne0 == nullptr) {
+        return cur;
+    }
+
+    const auto it = pad_orig_ne0->find(ggml_get_name(w));
+    if (it == pad_orig_ne0->end()) {
+        return cur;
+    }
+
+    const int64_t orig_ne0 = it->second;
+    GGML_ASSERT(orig_ne0 > 0 && orig_ne0 < w->ne[0]);
+    GGML_ASSERT(cur->ne[0] == orig_ne0 || cur->ne[0] == w->ne[0]);
+
+    if (cur->ne[0] == w->ne[0]) {
+        return cur;
+    }
+
+    return ggml_pad(ctx0, cur, (int) (w->ne[0] - orig_ne0), 0, 0, 0);
